# Este archivo es OPCIONAL. Si ya usas Claude Code con tu suscripcion
# Pro/Max, no necesitas copiarlo ni completar nada - saltatelo.
#
# Solo aplica si vas a usar el modo "API" descrito en el README
# (orquestacion desatendida/CI via Claude Agent SDK, en vez de tu sesion
# interactiva de Claude Code).

# --- Modo API (orchestration.engine: api en config/config.yaml) ---
ANTHROPIC_API_KEY=

# --- Context7 (opcional, en cualquier modo) ---
# Sin esta key, Context7 funciona igual pero con menos rate limit.
# Gratis en https://context7.com/dashboard
CONTEXT7_API_KEY=

# --- Memoria (solo si cambias embeddings_provider a algo distinto de "local") ---
OPENAI_API_KEY=

# --- Dashboard ---
DASHBOARD_PORT=4000
